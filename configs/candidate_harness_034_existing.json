{
  "env": {
    "PYTHONPATH": "src"
  },
  "variants": [
    {
      "name": "034_existing_rollout_credit_anchored",
      "train": {
        "name": "train_existing_034",
        "command": ["python", "-c", "print('existing 034 checkpoint')"],
