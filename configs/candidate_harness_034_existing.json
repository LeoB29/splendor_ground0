            {
              "name": "bought_points_drop_no_worse_than_one",
              "path": "paired_first_two_labels.end_metric_delta_after_minus_before.bought_card_points_mean",
              "op": ">=",
              "value": -1.0
            }
          ]
        }
      ],
      "benchmarks": []
    }
