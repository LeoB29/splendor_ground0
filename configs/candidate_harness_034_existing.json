          ],
          "gates": [
            {
              "name": "broad_agreement_at_least_95pct",
              "path": "overall.top_action_agreement_rate",
              "op": ">=",
              "value": 0.95
            }
          ]
        },
        {
          "name": "protected_drift",
          "command": ["python", "-c", "print('existing protected drift')"],
          "output_path": "outputs/analysis/policy_drift_022_034_regression_anchors.json",
          "skip_if_outputs_exist": [
            "outputs/analysis/policy_drift_022_034_regression_anchors.json"
          ],
          "gates": [
            {
              "name": "protected_agreement_at_least_98pct",
              "path": "overall.top_action_agreement_rate",
              "op": ">=",
              "value": 0.98
            }
          ]
        },
        {
          "name": "conversion",
          "command": ["python", "-c", "print('existing conversion diagnostic')"],
          "output_path": "outputs/analysis/conversion_diagnostics_022_034_diff10.json",
          "skip_if_outputs_exist": [
